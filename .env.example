# ==============================================================================
# JARVIS V1 — CENTRAL ENVIRONMENT FILE (TEMPLATE)
# ------------------------------------------------------------------------------
# Every port, URL, secret and third-party endpoint used by ANY package lives
# here. Nothing is hardcoded in the source anymore.
#
#   cp .env.example .env
#
# Read by:
#   packages/server   -> src/env.ts        (dotenv, walks up to repo root)
#   packages/web      -> next.config.ts    (@next/env, walks up to repo root)
#   packages/desktop  -> src/main.ts       (dotenv, walks up to repo root)
#
# Precedence: real OS environment variables always win over this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HOST AGENT — NETWORK
# ------------------------------------------------------------------------------
# Interface the Host Agent binds to. 0.0.0.0 = reachable from the whole LAN.
HOST_BIND_ADDRESS=0.0.0.0

# REST + Socket.IO API port (Host Agent).
PORT=4000

# Port the Next.js Web UI is served on (Host Deck / Controller Deck / PWA).
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 2. HOST AGENT — IDENTITY & RUNTIME
# ------------------------------------------------------------------------------
# NODE_ENV is deliberately NOT set here: Node.js and Next.js own it, and forcing
# a value from .env makes `next build` run in dev mode. The Host Agent falls
# back to "development", and the packaged Electron shell forces "production".

# Display name shown in the UI and inside the pairing QR payload.
HOST_NAME=JARVIS-Windows-Host

# Where pairings/sessions are cached. Empty = %USERPROFILE%\.jarvis-host
DATA_DIR=

# ------------------------------------------------------------------------------
# 3. HOST AGENT — SECURITY & SESSION LIFECYCLE
# ------------------------------------------------------------------------------
# 64 hex characters used to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty an ephemeral key is generated on every boot (all sessions drop).
JARVIS_SECRET=

# Pairing challenge nonce lifetime (Default: 60000 = 60s)
PAIRING_NONCE_TTL_MS=60000

# Paired session lifetime (Default: 604800000 = 7 days)
SESSION_TTL_MS=604800000

# Pairing attempts allowed per client IP per minute (Default: 5)
MAX_PAIRING_ATTEMPTS_PER_MIN=5

# CORS allow-list. '*' for plain LAN usage, or comma-separated origins.
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. WEB / PWA CLIENT  (inlined into the browser bundle at build time)
# ------------------------------------------------------------------------------
# IMPORTANT: leave the two *_URL values EMPTY for normal LAN use.
# When empty the client auto-detects the host from window.location and appends
# NEXT_PUBLIC_API_PORT — that is what makes a phone on Wi-Fi work.
# Only set them for a fixed/cloud backend, e.g. https://jarvis.example.com

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# Ports used when the URLs above are empty.
NEXT_PUBLIC_API_PORT=4000
NEXT_PUBLIC_WEB_PORT=3000

# ------------------------------------------------------------------------------
# 5. WEBRTC ICE SERVERS
# ------------------------------------------------------------------------------
# Comma separated. Google STUN is enough for most home Wi-Fi networks.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302

# TURN is only required across strict NATs / mobile carrier networks.
# Leave empty to disable. Comma separate multiple URLs.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 6. ELECTRON HOST SHELL (packages/desktop)
# ------------------------------------------------------------------------------
# Page the Electron window loads. Leave empty to auto-build it from WEB_PORT.
WEB_URL=

# ------------------------------------------------------------------------------
# 7. ANDROID CONTROLLER APK (packages/android)
# ------------------------------------------------------------------------------
# The APK normally auto-configures itself from the Host QR code, which already
# carries the Host LAN IP + PORT + WEB_PORT. Set this only to pin a fixed
# Web UI host instead, e.g. http://192.168.1.50:3000
ANDROID_DEFAULT_HOST_URL=