# ==============================================================================
# JARVIS V1 — CENTRAL ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ==============================================================================
# 🌐 SECTION 1: WEB (Frontend — packages/web / Next.js / PWA)
# ==============================================================================
# এই ভেরিয়েবলগুলো Next.js বিল্ড টাইমে ব্রাউজার বান্ডেলের ভিতরে ইনলাইন হয়।
# ক্লাউডে (Railway Web) বিল্ড করার পূর্বে এই মানগুলো সেট থাকা আবশ্যক।

# 1. Backend REST API Base URL
# ক্লাউড প্রোডাকশনে: https://jarvisserver-production-613e.up.railway.app
# লোকাল ওয়াইফাই/LAN মোডে: ফাঁকা রাখুন (ব্রাউজার স্বয়ংক্রিয়ভাবে ডিটেক্ট করবে)
NEXT_PUBLIC_API_URL=https://jarvisserver-production-613e.up.railway.app

# 2. Socket.IO Realtime Gateway URL
# ক্লাউড প্রোডাকশনে: https://jarvisserver-production-613e.up.railway.app
# লোকাল ওয়াইফাই/LAN মোডে: ফাঁকা রাখুন
NEXT_PUBLIC_SOCKET_URL=https://jarvisserver-production-613e.up.railway.app

# 3. Fallback Ports (যখন উপরের URL গুলো ফাঁকা থাকে)
NEXT_PUBLIC_API_PORT=4000
NEXT_PUBLIC_WEB_PORT=3000

# 4. WebRTC STUN Server (লোকাল/হোম নেটওয়ার্কে স্ক্রিন শেয়ারিংয়ের জন্য)
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302

# 5. WebRTC TURN Server (মোবাইল নেটওয়ার্ক / ভিন্ন ওয়াইফাইয়ে স্ক্রিন শেয়ারিংয়ের জন্য - অপশনাল)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=


# ==============================================================================
# 🖥️ SECTION 2: SERVER (Backend — packages/server / Express / Socket.IO)
# ==============================================================================
# এই ভেরিয়েবলগুলো ব্যাকএন্ড নোড.জেএস সার্ভার রান টাইমে ব্যবহার করে।
# Railway Server ড্যাশবোর্ডে Environment Variables ট্যাবে এগুলো সেট করতে হয়।

# 1. Server Network Port (Railway সার্ভার স্বয়ংক্রিয়ভাবে $PORT সেট করে)
PORT=4000

# 2. Host Bind Address (সব নেটওয়ার্ক ইন্টারফেসে লিসেন করার জন্য 0.0.0.0)
HOST_BIND_ADDRESS=0.0.0.0

# 3. Web UI Port (হোস্ট নোটিফিকেশন লিংকের জন্য)
WEB_PORT=3000

# 4. Server Public Internet URL (QR কোডে ক্লাউড অ্যাড্রেস পাঠানোর জন্য)
# Railway সার্ভারের পাবলিক ডোমেইন (যেমন: https://jarvisserver-production-613e.up.railway.app)
PUBLIC_SIGNALING_URL=https://jarvisserver-production-613e.up.railway.app

# 5. Security Signing Secret (HMAC Token Security — 64 Hex Characters)
# একটি স্ট্যাবল 64-character হেক্স কী দিন, যাতে সার্ভার রিস্টার্ট হলেও পেয়ারিং ড্রপ না হয়।
# জেনারেট কমান্ড: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JARVIS_SECRET=e7b4f3a890123456789abcdef0123456789abcdef0123456789abcdef0123456

# 6. Host Device Display Name (QR কোড এবং কন্ট্রোলার স্ক্রিনে দেখাবে)
HOST_NAME=JARVIS-Windows-Host

# 7. Pairing QR Challenge Expiration (মিলিসেকেন্ডে, ডিফল্ট: ৬০ সেকেন্ড)
PAIRING_NONCE_TTL_MS=60000

# 8. Paired Controller Session Lifetime (মিলিসেকেন্ডে, ডিফল্ট: ৭ দিন)
SESSION_TTL_MS=604800000

# 9. Rate Limit (প্রতি মিনিটে প্রতি আইপি থেকে সর্বোচ্চ পেয়ারিং চেষ্টার সংখ্যা)
MAX_PAIRING_ATTEMPTS_PER_MIN=5

# 10. CORS Allow-List (সব ডোমেইন এলাউ করতে '*')
CORS_ORIGIN=*

# 11. Allow Remote Host Mode (ক্লাউড মোডে রিমোট হোস্ট ক্রিডেনশিয়াল অনুমোদনের জন্য)
ALLOW_REMOTE_HOST=true

# 12. Local Pairing Cache Directory (ফাঁকা রাখলে %USERPROFILE%\.jarvis-host)
DATA_DIR=


# ==============================================================================
# 🔄 SECTION 3: SHARED / BOTH (যেগুলো উভয় জায়গায় ব্যবহৃত হয়)
# ==============================================================================
# ১. Backend API / Server URL:
#    - Web এ:    NEXT_PUBLIC_API_URL=https://jarvisserver-production-613e.up.railway.app
#    - Server এ: PUBLIC_SIGNALING_URL=https://jarvisserver-production-613e.up.railway.app
#
# ২. WebRTC Signaling (STUN/TURN):
#    - Web ব্রাউজার স্ক্রিন স্ট্রিম রিসিভ করার জন্য STUN/TURN ব্যবহার করে।
#
# ৩. Local Dev Ports:
#    - API_PORT: 4000
#    - WEB_PORT: 3000