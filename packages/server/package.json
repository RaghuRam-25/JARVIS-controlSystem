{
  "name": "@jarvis/server",
  "version": "1.0.0",
  "main": "./dist/server.js",
  "scripts": {
    "prebuild": "npm run build --workspace=@jarvis/shared",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --test dist/**/*.test.js",
    "test:security": "tsx src/tests/security.test.ts",
    "test:hardening": "tsx src/tests/hardening.test.ts",
    "test:http": "tsx src/tests/http.integration.test.ts",
    "test:e2e": "tsx src/tests/e2e.test.ts",
    "test:reconnect": "tsx src/tests/reconnect.lifecycle.test.ts"
  },
  "dependencies": {
    "@jarvis/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
